# Copy to .env (gitignored). `python -m scripts.setup_wallet` fills the first three for you.
HL_NETWORK=testnet                 # testnet or mainnet
HL_ACCOUNT_ADDRESS=0xYourMainWalletAddress
HL_SECRET_KEY=0xYourApiWalletPrivateKey   # API wallet key, NOT your main wallet key

# Referral (see README "Referral disclosure")
# HL_REFERRAL=off                  # uncomment to skip applying a referral code
# HL_REFERRAL_CODE=CONCEPT211
